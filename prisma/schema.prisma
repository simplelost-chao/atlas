generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  teamMembers TeamMember[]
  comments    Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Team ───────────────────────────────────────

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TeamMember[]
  projects  Project[]
  apiKeys   ApiKey[]
  invites   TeamInvite[]
}

model TeamMember {
  id     String   @id @default(cuid())
  role   TeamRole @default(EDITOR)
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole @default(EDITOR)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ApiKey {
  id           String   @id @default(cuid())
  teamId       String
  provider     String
  encryptedKey String
  label        String?
  createdAt    DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, provider])
}

// ─── Project & Industry Chain ───────────────────

model Project {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  industry    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chain IndustryChain?
}

model IndustryChain {
  id        String      @id @default(cuid())
  projectId String      @unique
  status    ChainStatus @default(PENDING)
  maxDepth  Int         @default(4)
  logs      Json[]      @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes          ChainNode[]
  edges          ChainEdge[]
  collabDocument CollabDocument?
}

enum ChainStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum NodeType {
  UPSTREAM
  MIDSTREAM
  DOWNSTREAM
}

// Review status for Python-mined nodes (TS pipeline nodes default to CONFIRMED).
enum NodeSyncStatus {
  PROPOSED   // Mined by Python CLI, pending human review
  CONFIRMED  // Approved (either TS pipeline auto or human review)
  REJECTED   // Rejected in review
}

// Origin of a node: TS pipeline or Python CLI sync.
enum NodeSyncSource {
  ATLAS_PIPELINE  // Generated by TS LLM pipeline (default)
  PYTHON_CLI      // Synced from ia expand + ia review
}

model ChainNode {
  id           String   @id @default(cuid())
  chainId      String
  parentId     String?
  name         String
  description  String   @default("")
  nodeType     NodeType
  level        Int      @default(0)
  order        Int      @default(0)
  profitMargin String?
  marketSize   String?
  growthTrend  String?
  keyDrivers   String[] @default([])
  valueFlow    String?
  // Entity resolution: aliases (CN/EN/code variants) + normalized match key.
  aliases      String[] @default([])
  normKey      String   @default("")
  // Python CLI sync fields
  syncStatus   NodeSyncStatus @default(CONFIRMED)
  syncSource   NodeSyncSource @default(ATLAS_PIPELINE)
  evidenceGrade String?       // A-E from Serenity methodology; null for TS-generated
  bottleneckLayer String?     // 技术物理层 / 工艺设备层 / etc.
  themeIds     String[] @default([])  // ARK theme IDs (for chokepoint detection)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chain     IndustryChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  parent    ChainNode?    @relation("NodeTree", fields: [parentId], references: [id])
  children  ChainNode[]   @relation("NodeTree")
  companies    Company[]
  companyNodes CompanyNode[]
  upstreamEdges   ChainEdge[] @relation("EdgeDownstream")
  downstreamEdges ChainEdge[] @relation("EdgeUpstream")

  @@index([chainId, normKey])
  @@index([syncStatus])
}

// Explicit DAG edges from Python CLI sync — separate from the parentId tree.
// Allows cross-chain chokepoint detection: a node appearing in multiple chains
// via edges (not just parentId) is a candidate chokepoint.
model ChainEdge {
  id           String   @id @default(cuid())
  upstreamId   String
  downstreamId String
  rationale    String   @default("")
  chainId      String
  syncSource   NodeSyncSource @default(PYTHON_CLI)
  createdAt    DateTime @default(now())

  upstream   ChainNode     @relation("EdgeUpstream",   fields: [upstreamId],   references: [id], onDelete: Cascade)
  downstream ChainNode     @relation("EdgeDownstream",  fields: [downstreamId], references: [id], onDelete: Cascade)
  chain      IndustryChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@unique([upstreamId, downstreamId, chainId])
  @@index([chainId])
  @@index([upstreamId])
  @@index([downstreamId])
}

model CompanyNode {
  id             String   @id @default(cuid())
  companyId      String
  chainNodeId    String
  marketPosition String   @default("EMERGING")
  createdAt      DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chainNode ChainNode @relation(fields: [chainNodeId], references: [id], onDelete: Cascade)

  @@unique([companyId, chainNodeId])
  @@index([companyId])
  @@index([chainNodeId])
}

enum MarketPosition {
  LEADER
  CHALLENGER
  EMERGING
  NICHE
}

model Company {
  id          String @id @default(cuid())
  chainNodeId String

  name         String
  ticker       String?
  exchange     String?
  isPublic     Boolean  @default(false)
  country      String?
  mainBusiness String   @default("")
  coreProducts String[] @default([])

  // Entity resolution: aliases (CN/EN/code variants) + normalized match key.
  aliases String[] @default([])
  normKey String   @default("")

  marketCap     String?
  revenue       String?
  revenueGrowth String?
  grossMargin   String?
  netMargin     String?
  roe           String?
  financialTrend Json?

  marketPosition MarketPosition @default(EMERGING)
  marketShare    String?
  moat           String?
  competitors    String[] @default([])

  highlights            String[] @default([])
  risks                 String[] @default([])
  analystRating         String?
  customerConcentration String?

  // Live market data (from Yahoo Finance API)
  yahooSymbol      String?
  liveMarketCap    BigInt?
  liveRevenue      BigInt?
  liveRevenueGrowth Decimal? @db.Decimal(8, 2)
  liveGrossMargin  Decimal? @db.Decimal(8, 2)
  liveNetMargin    Decimal? @db.Decimal(8, 2)
  liveRoe          Decimal? @db.Decimal(8, 2)
  livePrice        Decimal? @db.Decimal(12, 4)
  livePeRatio      Decimal? @db.Decimal(10, 2)
  liveChange       Decimal? @db.Decimal(8, 4)
  liveCurrency     String?
  liveOperatingMargin Decimal? @db.Decimal(8, 2)
  liveEbitda       BigInt?
  liveFreeCashflow BigInt?
  liveOperatingCashflow BigInt?
  liveTotalCash    BigInt?
  liveTotalDebt    BigInt?
  liveDebtToEquity Decimal? @db.Decimal(8, 2)
  liveCurrentRatio Decimal? @db.Decimal(8, 2)
  liveForwardPE    Decimal? @db.Decimal(10, 2)
  livePriceToBook  Decimal? @db.Decimal(10, 2)
  liveEnterpriseValue BigInt?
  liveEps          Decimal? @db.Decimal(12, 4)
  liveBeta         Decimal? @db.Decimal(6, 3)
  livePegRatio     Decimal? @db.Decimal(8, 2)
  liveSharesOutstanding BigInt?
  liveUpdatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainNode         ChainNode        @relation(fields: [chainNodeId], references: [id], onDelete: Cascade)
  companyNodes      CompanyNode[]
  supplierRelations SupplyRelation[] @relation("Supplier")
  customerRelations SupplyRelation[] @relation("Customer")

  @@index([ticker])
  @@index([normKey])
}

enum RelationType {
  SUPPLIER
  CUSTOMER
  PARTNER
}

model SupplyRelation {
  id           String       @id @default(cuid())
  supplierId   String
  customerId   String
  relationType RelationType
  description  String?
  createdAt    DateTime     @default(now())

  supplier Company @relation("Supplier", fields: [supplierId], references: [id], onDelete: Cascade)
  customer Company @relation("Customer", fields: [customerId], references: [id], onDelete: Cascade)
}

// ─── Collaboration ──────────────────────────────

model Comment {
  id         String            @id @default(cuid())
  chainId    String
  targetType CommentTargetType
  targetId   String
  userId     String
  content    String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chainId, targetId])
}

enum CommentTargetType {
  NODE
  COMPANY
}

model CollabDocument {
  id        String   @id @default(cuid())
  chainId   String   @unique
  state     Bytes
  updatedAt DateTime @updatedAt

  chain IndustryChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
}
